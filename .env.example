NODE_ENV=production
PORT=3120
HOST=127.0.0.1
# The public address, with no slash on the end.
SITE_ORIGIN=https://pompey.bike

# Set to true while the site is on a temporary address, so that search
# engines do not index a second copy of it.
NOINDEX=false

# Optional. The code from Google Search Console's "HTML tag" method of
# proving the site is yours (just the code, not the whole tag).
# GOOGLE_SITE_VERIFICATION=

# Everything that changes lives outside the code folder, so a deploy never
# touches it: the content checkout, resized image cache and editor list.
DATA_DIR=/home/matt/pcf-data
# Defaults to DATA_DIR/content.
# CONTENT_DIR=/home/matt/pcf-data/content

# What happens to the content repository on each save:
#   off     nothing (default, for local development)
#   commit  commit locally
#   push    commit, then pull and push CONTENT_BRANCH
CONTENT_GIT=push
CONTENT_BRANCH=main

# Editor sign-in at /edit uses Google. Create an OAuth 2.0 "Web application"
# client at https://console.cloud.google.com/apis/credentials and add this
# Authorised redirect URI: SITE_ORIGIN + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts of the site owners. Owners can edit, and
# can add or remove other editors on the People screen.
ADMIN_EMAILS=
# Any long random string: openssl rand -hex 32
SESSION_SECRET=

# Local development only (ignored when NODE_ENV=production): sign in as this
# address without Google. It must be listed in ADMIN_EMAILS.
# DEV_LOGIN_EMAIL=
